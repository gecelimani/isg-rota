<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Metin Atölyesi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTemizle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TÜMÜNÜ SİL"
            android:textColor="#FF5252" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:text="Burada gereksiz başlıkları silip, kaymış satırları düzeltebilirsin. İşin bitince soruları ayıkla butonuna bas."
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33888888">

        <EditText
            android:id="@+id/etHamMetinEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="top"
            android:hint="OCR metni buraya gelecek..."
            android:inputType="textMultiLine"
            android:padding="20dp"
            android:textSize="16sp"
            android:scrollbars="vertical"
            android:lineSpacingExtra="4dp"
            android:fontFamily="monospace" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSorulariAyikla"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="16dp"
        android:text="TEMİZLEDİM, SORULARI AYIKLA"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        android:backgroundTint="@color/primary" />

</LinearLayout>