<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Seçili durum: Hafif dolgulu ve ince vurgulu -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#1AE9C46A" /> <!-- %10 şeffaf accent -->
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <!-- Normal durum: Çok ince ve yumuşak çerçeve -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/colorSurfaceVariant" />
        </shape>
    </item>
</selector>